config obuspa 'global'
	option enabled '1'
	option dhcp_discovery '1'
	option log_level '2'
	option prototrace '0'
	option db_file '/etc/obuspa/usp.db'
	#option ipc_timeout '30'
	#option max_cache_time '600'
	#option trust_cert '/etc/obuspa/ca.pem'
	#option client_cert '/etc/obuspa/client.pem'
	option log_dest 'syslog'
	option dm_caching_exclude '/etc/obuspa/transient_dm.json'
	option dualstack_pref 'IPv6'

# --- USP Controller (Oktopus) onboarding example -------------------------------
# Uncomment and edit to connect to a controller over WebSocket. Two fields are
# easy to get wrong on a non-iopsys platform (both cost connection time):
#   * EndpointID MUST equal the controller's own endpoint id (what Oktopus
#     reports, e.g. 'oktopusController'); a mismatch makes obuspa drop every
#     USP record with "inconsistent endpoint".
#   * assigned_role_name='full_access' is REQUIRED for ws:// (no TLS client
#     cert -> the controller otherwise falls back to the Untrusted role and
#     cannot read the data model / discovery hangs).
#config controller 'oktopus'
#	option Enable '1'
#	option Protocol 'WebSocket'
#	option EndpointID 'oktopusController'
#	option assigned_role_name 'full_access'
#	option Host '192.0.2.1'
#	option Port '8080'
#	option Path '/ws/agent'
#	option EnableEncryption '0'

# --- Agent identity -----------------------------------------------------------
